{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm run build:lancamento"
      }
    }
  ],
  "routes": [
    {
      "src": "/lancamento",
      "dest": "/index.html"
    },
    {
      "src": "/lancamento/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {},
  "env": {
    "NODE_VERSION": "22.x"
  }
}
